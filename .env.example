TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Репозиторий GitHub (PUBLIC_ — доступны в браузере, нужны Keystatic)
PUBLIC_GITHUB_REPO_OWNER=your_github_username
PUBLIC_GITHUB_REPO_NAME=your_repo_name

# Keystatic CMS
# Оставь пустым для local-режима (без авторизации)
# Установи "github" чтобы включить GitHub OAuth (в том числе локально)
PUBLIC_KEYSTATIC_STORAGE=

KEYSTATIC_GITHUB_CLIENT_ID=your_github_oauth_client_id
KEYSTATIC_GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
KEYSTATIC_SECRET=your_random_secret_string
