---
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Екатерина Елизарова — психолог для подростков и взрослых',
  description = 'Психологическая помощь подросткам и взрослым. Запись на консультацию онлайн.',
} = Astro.props;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="font-sans bg-beige-50 text-gray-800 antialiased">
    <slot />
  </body>
</html>
