---
import PageLayout from '../../layouts/PageLayout.astro';
import BookButton from '../../components/BookButton.astro';
import { getCollection } from 'astro:content';

export const prerender = false;

const { slug } = Astro.params;
const posts = await getCollection('posts');
const post = posts.find(p => p.slug === slug);

if (!post) {
  return Astro.redirect('/blog');
}

const { Content } = await post.render();
---

<PageLayout title={`${post.data.title} — Екатерина Елизарова`} description={post.data.excerpt}>
  <article class="max-w-3xl mx-auto px-6 py-12">
    <!-- Header -->
    <div class="mb-10">
      <a href="/blog" class="text-beige-600 text-sm hover:text-beige-800 transition-colors inline-flex items-center gap-1 mb-6">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        Назад к публикациям
      </a>
      {post.data.date && (
        <time class="text-beige-600 text-sm font-medium block mb-3">
          {new Date(post.data.date).toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' })}
        </time>
      )}
      <h1 class="text-3xl md:text-4xl font-semibold text-gray-800 leading-tight">{post.data.title}</h1>
    </div>

    <!-- Cover -->
    {post.data.cover && (
      <div class="aspect-video rounded-2xl overflow-hidden mb-10 bg-beige-100">
        <img src={post.data.cover} alt={post.data.title} class="w-full h-full object-cover" />
      </div>
    )}

    <!-- Content -->
    <div class="article-content">
      <Content />
    </div>

  </article>
</PageLayout>

<style is:global>
  .article-content {
    color: #374151;
    font-size: 1.0625rem;
    line-height: 1.75;
  }
  .article-content p {
    margin-bottom: 1.25rem;
  }
  .article-content h2 {
    font-size: 1.375rem;
    font-weight: 600;
    color: #1f2937;
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
  }
  .article-content h3 {
    font-size: 1.125rem;
    font-weight: 600;
    color: #1f2937;
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
  }
  .article-content ul,
  .article-content ol {
    padding-left: 1.5rem;
    margin-bottom: 1.25rem;
  }
  .article-content ul {
    list-style-type: disc;
  }
  .article-content ol {
    list-style-type: decimal;
  }
  .article-content li {
    margin-bottom: 0.375rem;
  }
  .article-content strong {
    font-weight: 600;
    color: #1f2937;
  }
  .article-content a {
    color: #846b52;
    text-decoration: underline;
  }
  .article-content blockquote {
    border-left: 3px solid #ddd0b8;
    padding-left: 1rem;
    color: #6b7280;
    font-style: italic;
    margin: 1.5rem 0;
  }
  .article-content img {
    display: block;
    max-width: 100%;
    height: auto;
    border-radius: 1rem;
    margin: 1.5rem 0;
  }
</style>
