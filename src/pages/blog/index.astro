---
import PageLayout from '../../layouts/PageLayout.astro';
import ProductCard from '../../components/ProductCard';
import { getCollection } from 'astro:content';

const posts = await getCollection('posts');
const products = await getCollection('products');

const sortedPosts = posts.sort((a, b) =>
  new Date(b.data.date ?? 0).getTime() - new Date(a.data.date ?? 0).getTime()
);
---

<PageLayout title="Публикации — Екатерина Елизарова" description="Статьи и материалы психолога Екатерины Елизаровой">
  <div class="max-w-4xl mx-auto px-6 py-12">
    <h1 class="text-3xl md:text-4xl font-semibold text-gray-800 mb-2">Публикации</h1>
    <p class="text-gray-500 mb-12">Статьи, чек-листы и руководства для вашего развития</p>

    <!-- Articles section -->
    <section class="mb-16">
      <h2 class="text-2xl font-semibold text-gray-800 mb-6">Статьи</h2>
      {sortedPosts.length === 0 ? (
        <div class="bg-beige-50 rounded-2xl p-10 text-center border border-beige-100">
          <p class="text-gray-400">Статьи скоро появятся</p>
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {sortedPosts.map(post => (
            <a href={`/blog/${post.slug}`} class="group bg-white rounded-2xl overflow-hidden shadow-sm border border-beige-100 hover:shadow-md transition-shadow">
              <div class="aspect-video bg-beige-100 relative overflow-hidden">
                {post.data.cover ? (
                  <img src={post.data.cover} alt={post.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
                ) : (
                  <div class="w-full h-full bg-gradient-to-br from-beige-100 to-beige-200"></div>
                )}
              </div>
              <div class="p-6">
                <time class="text-beige-600 text-xs font-medium mb-2 block">
                  {new Date(post.data.date).toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' })}
                </time>
                <h3 class="font-semibold text-gray-800 text-lg group-hover:text-beige-700 transition-colors mb-2">{post.data.title}</h3>
                {post.data.excerpt && (
                  <p class="text-gray-500 text-sm line-clamp-2">{post.data.excerpt}</p>
                )}
              </div>
            </a>
          ))}
        </div>
      )}
    </section>

    <!-- Materials section -->
    <section>
      <h2 class="text-2xl font-semibold text-gray-800 mb-2">Материалы</h2>
      <p class="text-gray-500 text-sm mb-6">Чек-листы, руководства и рабочие тетради</p>
      {products.length === 0 ? (
        <div class="bg-beige-50 rounded-2xl p-10 text-center border border-beige-100">
          <p class="text-gray-400">Материалы скоро появятся</p>
        </div>
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
          {products.map(product => (
            <ProductCard
              client:load
              title={product.data.title}
              description={product.data.description}
              price={product.data.price}
              cover={product.data.cover}
            />
          ))}
        </div>
      )}
    </section>
  </div>
</PageLayout>
